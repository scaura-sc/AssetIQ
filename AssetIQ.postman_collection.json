{
  "info": {
    "name": "AssetIQ Backend API",
    "description": "REST API for the AssetIQ backend. Every request needs X-Tenant-Id (set at collection level). See API_DOCUMENTATION.md for full field reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "tenantId", "value": "coca-cola" }
  ],
  "auth": null,
  "header": [
    { "key": "X-Tenant-Id", "value": "{{tenantId}}" }
  ],
  "item": [
    {
      "name": "Asset Catalog",
      "item": [
        {
          "name": "Create catalog entry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/asset-catalog",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"level\": \"MODEL\",\n  \"code\": \"VC-300L\",\n  \"name\": \"VisiCooler 300L\",\n  \"parentCode\": \"VISI_COOLER\",\n  \"manufacturerName\": \"Western Refrigeration Pvt Ltd\",\n  \"manufacturerCountry\": \"India\",\n  \"defaultWarrantyMonths\": 24,\n  \"defaultUsefulLifeYears\": 8,\n  \"defaultDepreciationMethod\": \"SLM\",\n  \"defaultPmFrequencyDays\": 90,\n  \"defaultPurityClausePct\": 95.00,\n  \"capacity\": 300.00,\n  \"capacityUnit\": \"Litres\"\n}"
            }
          }
        },
        {
          "name": "Update catalog entry",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/asset-catalog/900001003",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VisiCooler 300L (rev)\",\n  \"defaultWarrantyMonths\": 24\n}"
            }
          }
        },
        {
          "name": "Get catalog entry",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/asset-catalog/900001003" }
        },
        {
          "name": "List by level",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/asset-catalog?level=CATEGORY" }
        },
        {
          "name": "List children of a code",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/asset-catalog/children?parentCode=COOLER" }
        },
        {
          "name": "List available models",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/asset-catalog/models/available" }
        },
        {
          "name": "Deactivate catalog entry",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/asset-catalog/900001003" }
        }
      ]
    },
