<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="005-1-create-aiq_asset_association" author="assetiq">
        <createTable tableName="aiq_asset_association">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!-- Soft reference to aiq_asset.id — no FK -->
            <column name="asset_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="asset_number" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="location_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="location_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="location_name" type="VARCHAR(100)"/>
            <column name="territory_code" type="VARCHAR(30)"/>
            <column name="salesman_code" type="VARCHAR(30)"/>
            <column name="custodian_name" type="VARCHAR(100)"/>
            <column name="custodian_phone" type="VARCHAR(20)"/>
            <column name="assignment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="expected_return_date" type="DATE"/>
            <column name="assignment_type" type="VARCHAR(20)" defaultValue="PERMANENT">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_ref" type="VARCHAR(50)"/>
            <column name="has_contract" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="contract_ref" type="VARCHAR(50)"/>
            <column name="deposit_amount" type="DECIMAL(14,2)"/>
            <column name="deposit_status" type="VARCHAR(20)"/>
            <column name="exclusivity_flag" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="purity_clause_pct" type="DECIMAL(5,2)"/>
            <column name="contract_start_date" type="DATE"/>
            <column name="contract_end_date" type="DATE"/>
            <column name="contract_document_url" type="VARCHAR(500)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="005-2-index-aiq_asset_association-asset" author="assetiq">
        <createIndex tableName="aiq_asset_association" indexName="idx_asset_assoc_tenant_asset">
            <column name="tenant_id"/>
            <column name="asset_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-3-index-aiq_asset_association-location" author="assetiq">
        <createIndex tableName="aiq_asset_association" indexName="idx_asset_assoc_tenant_location">
            <column name="tenant_id"/>
            <column name="location_type"/>
            <column name="location_code"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
