<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="010-1-create-aiq_ai_vision_result_log" author="assetiq">
        <createTable tableName="aiq_ai_vision_result_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!-- Soft reference to aiq_visit_asset_capture.id — no FK -->
            <column name="visit_capture_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Soft reference to aiq_asset.id — no FK -->
            <column name="asset_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="photo_url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="model_version" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="detected_purity_pct" type="DECIMAL(5,2)"/>
            <column name="detected_condition" type="VARCHAR(20)"/>
            <column name="detected_brand" type="VARCHAR(50)"/>
            <column name="confidence_score" type="DECIMAL(5,2)"/>
            <!-- Full model output as a JSON string — not a native JSON/JSONB column -->
            <column name="raw_result" type="VARCHAR(2000)"/>
            <column name="processing_status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="010-2-index-aiq_ai_vision_result_log-asset" author="assetiq">
        <createIndex tableName="aiq_ai_vision_result_log" indexName="idx_ai_vision_tenant_asset">
            <column name="tenant_id"/>
            <column name="asset_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="010-3-index-aiq_ai_vision_result_log-capture" author="assetiq">
        <createIndex tableName="aiq_ai_vision_result_log" indexName="idx_ai_vision_tenant_visit_capture">
            <column name="tenant_id"/>
            <column name="visit_capture_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
